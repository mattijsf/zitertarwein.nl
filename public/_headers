# Cache policy. Vite puts the scripts, styles and data chunks in /assets/
# with a content hash in the file name, so their URLs change whenever they
# change and the files themselves can be cached forever. index.html and
# sw.js must always revalidate (default).

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/icon-maskable-512.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/og-image.png
  Cache-Control: public, max-age=86400

/plaat-tarwe.webp
  Cache-Control: public, max-age=31536000, immutable
